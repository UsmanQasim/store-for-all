# Public site URL (no trailing slash) — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://dukaan.app
# Same Supabase project as the app. The anon key is public by design; RLS controls access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
NEXT_PUBLIC_ANDROID_PACKAGE=com.dukaan.app
NEXT_PUBLIC_APP_SCHEME=dukaan
NEXT_PUBLIC_SUPPORT_EMAIL=support@dukaan.app
