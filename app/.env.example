# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Where the landing page is hosted (used for QR links + legal pages)
EXPO_PUBLIC_WEB_URL=https://dukaan.app
# Filled after first `eas init`
EAS_PROJECT_ID=
# Optional: a pre-created Supabase user (email + password) for Google Play app review.
EXPO_PUBLIC_REVIEW_EMAIL=
